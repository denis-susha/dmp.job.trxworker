# Environment variables read by Job.TrxWorker (standard .NET configuration: "__" separates sections).
DOTNET_ENVIRONMENT=Production

ConnectionStrings__DmpConnection=Host=postgres-dmp;Port=5432;Database=dmarketplace;Username=admin;Password=change-me
ConnectionStrings__BillingDbConnection=Host=dmp-db-billing;Port=5432;Database=billing;Username=admin;Password=change-me

# Bitcart invoices endpoint (no trailing slash)
BitcartOptions__ApiUrl=http://bitcart-backend:8000/invoices

# Public MinIO/S3 endpoint used for the logo URL in emails
Minio__S3PublicEndpoint=https://s3.example.com

# Front-end hosts used for links in emails
DmpHosts__Client=https://example.com
DmpHosts__Seller=https://seller.example.com
